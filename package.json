{
  "name": "rouge-theme-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "rolldown": "^1.1.3"
    }
  },
  "scripts": {
    "build": "bun run --filter 'rouge-theme' build",
    "pkg": "bun run --filter 'rouge-theme' pkg",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.10",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
