{
  "name": "rouge-theme",
  "displayName": "Rouge Theme",
  "version": "2.1.6",
  "private": true,
  "description": "Warm and cozy dark theme for VSCode",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "color-theme",
    "dark",
    "rouge",
    "theme"
  ],
  "homepage": "https://github.com/josefaidt/rouge-theme/readme.md",
  "bugs": {
    "url": "https://github.com/josefaidt/rouge-theme/issues"
  },
  "author": "Josef Aidt <josef.aidt@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/josefaidt/rouge-theme.git"
  },
  "publisher": "josef",
  "scripts": {
    "build": "bun run build:themes && bun run build:copy",
    "build:themes": "bun run --filter '@rouge/rouge-*' build",
    "build:copy": "bun run ../../scripts/copy-themes.ts",
    "vscode:prepublish": "bun run build",
    "pkg": "bun run build && vsce package"
  },
  "devDependencies": {
    "@rouge/rouge-1": "workspace:*",
    "@rouge/rouge-2": "workspace:*",
    "@rouge/rouge-3": "workspace:*",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "3.6.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Rouge 3",
        "uiTheme": "vs-dark",
        "path": "./themes/rouge3.json"
      },
      {
        "label": "Rouge 2",
        "uiTheme": "vs-dark",
        "path": "./themes/rouge2.json"
      },
      {
        "label": "Rouge",
        "uiTheme": "vs-dark",
        "path": "./themes/rouge.json"
      },
      {
        "label": "Rouge No Italics",
        "uiTheme": "vs-dark",
        "path": "./themes/rouge-no-italics.json"
      }
    ]
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#172030",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.22.0"
  }
}
