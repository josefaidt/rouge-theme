---
interface Props {
  title: string
  families: Record<string, Record<string, string>>
}

const { title, families } = Astro.props
---

<section class="mb-16">
  <h2 class="heading mb-4 text-2xl font-semibold">{title}</h2>
  <div class="flex flex-col gap-3">
    {
      Object.entries(families).map(([name, shades]) => (
        <div class="flex items-center gap-4">
          <span class="label w-28 shrink-0 font-mono text-sm">{name}</span>
          <div class="flex gap-1.5">
            {Object.entries(shades).map(([shade, hex]) => (
              <div class="flex flex-col items-center gap-1" title={`${name}.${shade}`}>
                <div class="swatch h-10 w-10 rounded" style={`background-color:${hex}`} />
                <span class="label font-mono text-[10px]">{hex}</span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .heading {
    color: var(--fg);
  }

  .label {
    color: var(--fg);
  }

  .swatch {
    border: 1px solid var(--border);
  }
</style>
